# SanctuaryCompanion — Machine-Specific Configuration
# Copy this file to .env and adjust for your machine.
# .env is gitignored and never committed.

# Path to D2R save files (defaults to ~/Saved Games/Diablo II Resurrected)
# SANCTUARY_SAVES_DIR=C:/Users/yourname/Saved Games/Diablo II Resurrected

# === Sync Configuration ===

# HOST mode: set on the machine that owns the vault and canonical saves.
# Binds the server to 0.0.0.0 so other machines on the LAN can connect.
# SANCTUARY_SYNC_HOST=true

# CLIENT mode: set on machines that sync from the host.
# Point at the host machine's hostname or LAN IP (e.g., http://desktop-name:5173 or http://192.168.1.100:5173)
# SANCTUARY_SYNC_URL=http://my-desktop:5173

# Optional: unique machine name (defaults to OS hostname)
# SANCTUARY_MACHINE_ID=my-desktop

# Optional: custom bind host (overrides default 127.0.0.1 or 0.0.0.0)
# SANCTUARY_SERVER_HOST=127.0.0.1
