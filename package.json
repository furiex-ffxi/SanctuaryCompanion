{
  "name": "sanctuary-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:node && npm run test:react && npm run test:worker && npm run test:browser",
    "test:node": "node --test tests/item-display.test.js src/utils/tooltipPosition.test.js tests/unit/*.test.js tests/search/*.test.js tests/vault/*.test.js",
    "dev": "node scripts/dev/start-dev.mjs",
    "cleanup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/cleanup-dev.ps1",
    "build": "vite build",
    "replay:vault": "node scripts/vault/replay-vault-backup.mjs",
    "lint": "oxlint",
    "test:vault": "node --test tests/vault/*.test.js",
    "test:search": "node --test tests/search/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:react": "vitest run tests/react",
    "test:browser": "node scripts/test/browser.mjs",
    "test:worker": "node scripts/worker/build-d2r-worker.mjs && vitest run tests/integration",
    "test:images": "node scripts/test/item-images.mjs",
    "analyze:tz": "node scripts/tz-reverse-engineer.mjs",
    "analyze:tz-static": "node scripts/tz-static-analyze.mjs",
    "preview": "vite preview",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "chokidar": "^5.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "puppeteer": "^25.7.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
